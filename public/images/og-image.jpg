<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="ogBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="50%" style="stop-color:#2d2040"/>
      <stop offset="100%" style="stop-color:#1a1a2e"/>
    </linearGradient>
    <linearGradient id="ogAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#C9A96E"/>
      <stop offset="100%" style="stop-color:#8B6F47"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#ogBg)"/>
  <circle cx="600" cy="250" r="120" fill="none" stroke="url(#ogAccent)" stroke-width="2" opacity="0.4"/>
  <circle cx="600" cy="250" r="80" fill="none" stroke="url(#ogAccent)" stroke-width="1" opacity="0.3"/>
  <text x="600" y="270" text-anchor="middle" font-family="serif" font-size="56" fill="url(#ogAccent)" font-weight="bold">Beauty Journey</text>
  <text x="600" y="330" text-anchor="middle" font-family="sans-serif" font-size="28" fill="white" opacity="0.7">رحلتك الجمالية</text>
  <text x="600" y="400" text-anchor="middle" font-family="sans-serif" font-size="20" fill="white" opacity="0.5">وجهتك الفاخرة للعناية بالبشرة والشعر في مصر</text>
</svg>