<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#C9A96E;stop-opacity:0.9"/>
      <stop offset="100%" style="stop-color:#C9A96E;stop-opacity:0.6"/>
    </linearGradient>
    <pattern id="dots" width="40" height="40" patternUnits="userSpaceOnUse">
      <circle cx="20" cy="20" r="1.5" fill="white" opacity="0.3"/>
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <rect width="800" height="600" fill="url(#dots)"/>
  <circle cx="400" cy="250" r="80" fill="white" opacity="0.15"/>
  <circle cx="400" cy="250" r="60" fill="white" opacity="0.1"/>
  <text x="400" y="265" text-anchor="middle" font-family="serif" font-size="36" fill="white" font-weight="bold">العناية بالبشرة</text>
  <text x="400" y="310" text-anchor="middle" font-family="sans-serif" font-size="20" fill="white" opacity="0.7">Beauty Journey</text>
</svg>